{
  "expo": {
    "name": "Silo",
    "owner": "LCS Dev",
    "slug": "silo-app",
    "version": "1.3.16",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0284C7"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.cuang.silo"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0284C7"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "dev.cuang.silo",
      "versionCode": 23,
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.WRITE_CONTACTS",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "intentFilters": [
        {
          "action": "SEND",
          "category": [
            "DEFAULT"
          ],
          "data": [
            {
              "mimeType": "image/*"
            }
          ]
        },
        {
          "action": "SEND_MULTIPLE",
          "category": [
            "DEFAULT"
          ],
          "data": [
            {
              "mimeType": "image/*"
            }
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      "@react-native-community/datetimepicker",
      "expo-secure-store",
      "./plugins/withMlKitLatinOnly",
      "./plugins/withAndroidReleaseOptimization",
      "./plugins/withAndroidThemePolish",
      "./plugins/withReleaseSigning",
      "./plugins/withAndroidComponentHardening",
      "./plugins/withKeepDataOnUninstall",
      "./plugins/withLargeScreens",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Silo to use Face ID to unlock the app."
        }
      ],
      [
        "react-native-document-scanner-plugin",
        {
          "cameraPermission": "Silo uses the camera to scan receipts."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0284C7",
          "defaultChannel": "daily-reminder"
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Silo lets you pick contacts to import for splitting bills. Imported contacts stay on your phone."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "a92f4899-8a72-45dd-a858-cfa8b029f55c"
      }
    },
    "scheme": "silo"
  }
}
